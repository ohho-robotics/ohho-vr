  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>DRIVING</b>\n\u2022 Left Joystick: Move Forward/Back/Strafe\n\u2022
    Right Joystick: Turn (Yaw)\n\u2022 Right Grip: Turbo Speed\n\n<b>ROBOT ARM</b>\n\u2022
    Right Hand: Move physical hand to move gripper\n\u2022 Right Pinch: Open/Close
    Gripper\n\u2022 Left Thumbs-Up (Hold 0.5s): Enable/Clutch Arm\n\n<b>SAFETY</b>\n\u2022
    Both Grips Squeezed: Emergency Stop\n\n<b>DATASET RECORDING</b>\n\u2022 Start/Stop
    episodes using the right-side Teleop panel.\n\u2022 Use the buttons below to
    trigger ROSBags on the Pi."
  m_isRightToLeft: 0
